package HSEPack;

{$DESCRIPTION 'Hexagon Sprite Engine Pack'}

{ Delphi emits PACKAGEINFO lists in reverse declaration order. Unit-specific switches live in the units. }

{$R '..\..\res\HSEPack.res'}

requires
  vcl30,
  Gfxepack,
  Ilpack,
  Dcpack,
  Enginep,
  SoundP;

contains
  TerCBox,
  HSMEdit,
  HSSEdit,
  HSEdData,
  Terrain,
  ILTer,
  IsoHex,
  RndHex,
  Bridge,
  Road,
  BorderHx,
  HSLib,
  HSEdMod,
  ProgDlg,
  HSEngine,
  Hexagon;

end.
