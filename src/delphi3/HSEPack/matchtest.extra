{ matchtest.extra: routines that gen_host.py adds to the host, then the calls after "---" }
procedure UsePut(L: TXYLList);
var
  X: TXYL;
begin
  L[0] := X;
end;
procedure UseMapObject(O: TMapObject);
begin
  O.ResourceID := 0;
  Writeln(O.ResourceLinked);
end;
---
  UsePut(nil);
  UseMapObject(nil);
