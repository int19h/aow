function TStructure.MainValidateMap(Messages: TStrings): Boolean;
var
  Errors: TStringList;
  I: Integer;
begin
  Errors := TStringList.Create;
  Result := ValidateMap(Errors);
  if Errors.Count <> 0 then
  begin
