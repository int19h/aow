{ needs: EventLog.TEventLog.CenterViewTo has three Byte arguments. }
asm
  MOV EDX, [EAX+$18]
  MOV EDX, [EDX+$10]
  MOV CL, [EDX+$10]
  PUSH ECX
  MOV CL, [EDX+$0C]
  MOV DL, [EDX+8]
  CALL EventLog.TEventLog.CenterViewTo
