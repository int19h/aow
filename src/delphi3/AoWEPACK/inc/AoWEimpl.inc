  Field := Map.GetField(Xhx, Yhx, Lhx);
  FOwner := Field;
  CalcShowPriority;
  Success := PlaceOnMap;
  Field.RemoveChild(Self);
  FOwner := nil;
  SetOwner(Field);
  Result := Success;
end;


