  if not Moving then
  begin
    HPtoHX(Xhp, Yhp, X, Y);
    if (TMapField(Owner).Xhx <> X) or (TMapField(Owner).Yhx <> Y) then Result := False
    else Result := True;
  end
  else Result := False;
