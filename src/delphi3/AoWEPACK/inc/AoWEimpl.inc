  if Data <> nil then
  begin
    if Data.FLevel = 1 then
    begin
      SetAb(A1, FAbilityID, 0);
      A1.RemoveAbilityData(Data);
    end
    else
      Dec(Data.FLevel);
  end
  else
  begin
    SetAb(A1, FAbilityID, 0);
    Result := False;
  end;
end;
