  PString(A2)^ := '';
  { needs: Boolean result; P4 overrides remain unmarked procedures. }
  asm
    MOV EDX,A1
    MOV EAX,Self
    MOV ECX,[EAX]
    CALL DWORD PTR [ECX+$98]
    AND EAX,2
    SHR EAX,1
  end;
