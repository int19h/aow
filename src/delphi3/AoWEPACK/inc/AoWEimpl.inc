function TDamageEffectCA.Play(A1: TCombatViewer): Boolean;
{ needs: Boolean Play result despite the unmarked P4 overrides. }
asm
  PUSH EBX
  MOV EBX, EDX
  XOR EDX, EDX
  MOV DL, [EBX+$0C]
  ADD EDX, EDX
  CMP EDX, [EBX+$14]
  JNE @@Playing
  MOV EDX, [EBX+8]
  MOV ECX, [EAX]
  CALL DWORD PTR [ECX+$50]
@@Playing:
  XOR EAX, EAX
  MOV AL, [EBX+$0C]
  ADD EAX, EAX
  CMP EAX, [EBX+$14]
  SETG AL
  POP EBX
end;

