function TAdjacentArmy.GetMovementDays: Single;
var
  Points: Integer;
begin
  if FMoves <> 0 then
  begin
    Points := FPath.GetMovePoints;
    if Points > FMovePoints then Result := (Points - FMovePoints) / FMoves + 1
    else if Points <> 0 then Result := Points / FMovePoints
    else Result := 0;
  end
  else Result := 99;
end;

