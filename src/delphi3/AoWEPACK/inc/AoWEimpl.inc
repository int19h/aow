procedure TAdjustableUnit.MakeDefaultLevelUnit(Level: Shortint);
begin
  { Original retains protection from an earlier, higher-level setup. }
  case Level of
    1:
      begin
        FAttack := 4;
        FDefense := 2;
        FResistance := 3;
        FDamage := 3;
        FHits := 5;
        SetAbSet(21, 1);
        SetAbSet(0, 1);
        FImmunityTypes := [dtWall];
      end;
    2:
      begin
        FAttack := 5;
        FDefense := 3;
        FResistance := 3;
        FDamage := 3;
        FHits := 8;
        SetAbSet(21, 1);
        SetAbSet(0, 1);
        FImmunityTypes := [dtWall];
      end;
    3:
      begin
        FAttack := 6;
        FDefense := 3;
        FResistance := 4;
        FDamage := 7;
        FHits := 15;
        SetAbSet(21, 1);
        SetAbSet(0, 1);
        FImmunityTypes := [dtWall];
        FProtectionTypes := [dtPhysical];
      end;
    else
      begin
        FAttack := 6;
        FDefense := 3;
        FResistance := 4;
        FDamage := 7;
        FHits := 20;
        FImmunityTypes := [dtPhysical, dtWall];
        SetAbSet(21, 1);
        SetAbSet(0, 1);
      end;
  end;
  FHitPoints := FHits;
end;
