  Info: TShowMessageInfo;
begin
  if not AoWEngine.FRegistry.GetDebugMode and (Text <> '') then
    PlaySample('SFX\EVENTS\INFO2.WAV');
  Info.Text := Text;
  Info.Color := $FFFFFF;
  FShowMessageEvents.TriggerNotifyEvents(TObject(@Info));
  FMessageText := Text;
  FMessageFrame := $A0;
end;
