    Data.FLevel := 1;
    Data.FEnabled := True;
    SetAb(A1, FAbilityID, 1);
    A1.AddAbilityData(Data);
    Result := True;
  end
  else if Data.FLevel <> 3 then
  begin
    Result := True;
    Inc(Data.FLevel);
