package matchpkg;

{ The units of Enginep.dpl built as a package, like the original. Build from this directory with
  -UIlpack;Gfxepack: ImageLib comes from the Ilpack sources, as the original
  required ilpack. }

{$DESCRIPTION 'byte-match test package'}

requires
  vcl30;

contains
  FMemStr,
  EngineLists,
  zlib,
  Engine,
  EList,
  PlugInM,
  DebMDlg,
  ImgLComp,
  EResGrid;

end.
