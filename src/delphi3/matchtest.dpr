program matchtest;

{ Host program for the byte-matching experiment: it only has to reference every class so that the
  linker keeps them (every method of a class with a VMT is kept once the class is used). Build with
  the original compiler:
    C:\Tools\Delphi3\BIN\DCC32.EXE -GD -B "-UIlpack;Ilpack\stubs;Gfxepack" matchtest.dpr
  (ImageLib comes from Ilpack, which uses GFXE). The small units have their own hosts in hosts\.
  -GD writes matchtest.map with the address of every method; tools/match.py reads it. }

{$APPTYPE CONSOLE}

uses
  Windows,
  Classes,
  zlib in 'zlib.pas',
  ImageLib,
  FMemStr in 'FMemStr.pas',
  EngineLists in 'EngineLists.pas',
  Engine in 'Engine.pas';

var
  T: TPropertyTable;
  L: TIntegerList;
  LB: TByteList;
  LS: TShortIntList;
  LW: TWordList;
  LT: TBitList;
  LE: TEventList;
  LD: TDoubleItemList;
  LQ: TQuadItemList;
  DI: TDoubleItem;
  QI: TQuadItem;
  EV: TNotifyEvent;
  S: string;
  Flag: Boolean;
  O: TEObject;
  N: TENode;
  EN: TEngine;
  EL: TEObjectEditorList;
  Msg: TEMsg;
  M: TMemoryStream;
  HT: TIntegerHashTable256;
  HL: TIntegerHashList;
  CN: TEControlStyleNode;
  CO: TEControlStyleObject;
  CW: TECustomOwner;
  CL: TEObjectClassList;
  RS: TEResourceEditSettings;
  FM: TFastMemoryStream;
  OL: TEObjectList;
  TS: TEStorageStream;
  TT: TTranslateStorageStream;
  TN: TETimerNode;
  CH: TEChangeNotifyNode;
  SN: TESortNode;
  RN: TEReferenceNode;
  US: TEUser;
  RL: TEResourceList;
  RE: TEResource;
  CB: TCallBackEventList;
  CE: TCallBackEventList;
  SH: TStringHashTable256;
  SL: TStringHashList;
  EC: TEComponent;
  CBE: TCallBackEvent;
  RC: TRect;
  CS: TCompressStream;
  PI: TPlugIn;
  PC: TPlugInControl;
  DW: TDebugWriteStream;
  SLS: TStringList;
  CC: TECopyComponent;
begin
  T := TPropertyTable.Create;
  M := TMemoryStream.Create;
  T.Add(1, 0);
  T.Add(200, 300);
  T.BackupSettings;
  T.Add(2, 4);
  T.RestoreSettings;
  T.SaveToStream(M);
  M.Position := 0;
  T.Clear;
  T.LoadFromStream(M);
  Writeln(T.FindOffset(200), ' ', T.PropertyExist(1));
  M.Free;
  T.Free;
  L := TIntegerList.Create;
  L.ItemString := '1,2,3';
  L.Insert(0, 5);
  L.Move(0, 1);
  L.Exchange(0, 1);
  L.Pack;
  L.Remove(2);
  L[5] := 7;
  L.Sort(nil);
  M := TMemoryStream.Create;
  L.SaveToStream(M);
  M.Position := 0;
  L.LoadFromStream(M);
  M.Free;
  Writeln(L.ItemString, L.First, L.Last, L.Expand.Count, L.RandomChanceItem(1), L.Compare(L));
  L.Free;
  LB := TByteList.Create;
  LB.ItemString := '1,2,3';
  LB.Insert(0, 5);
  LB.Move(0, 1);
  LB.Exchange(0, 1);
  LB.Pack;
  LB.Remove(2);
  LB[5] := 7;
  LB.Sort(nil);
  M := TMemoryStream.Create;
  LB.SaveToStream(M);
  M.Position := 0;
  LB.LoadFromStream(M);
  M.Free;
  Writeln(LB.ItemString, LB.First, LB.Last, LB.Expand.Count, LB.RandomChanceItem(1), LB.Compare(LB));
  LB.Free;
  LS := TShortIntList.Create;
  LS.Add(1);
  LS.Insert(0, 5);
  LS.Move(0, 1);
  LS.Exchange(0, 1);
  LS.Pack;
  LS.Remove(2);
  LS[5] := 7;
  LS.Sort(nil);
  M := TMemoryStream.Create;
  LS.SaveToStream(M);
  M.Position := 0;
  LS.LoadFromStream(M);
  M.Free;
  Writeln(LS.First, LS.Last, LS.Expand.Count, LS.RandomChanceItem(1), LS.Compare(LS));
  LS.Free;
  LW := TWordList.Create;
  LW.Add(1);
  LW.Insert(0, 5);
  LW.Move(0, 1);
  LW.Exchange(0, 1);
  LW.Pack;
  LW.Remove(2);
  LW[5] := 7;
  LW.Sort(nil);
  M := TMemoryStream.Create;
  LW.SaveToStream(M);
  M.Position := 0;
  LW.LoadFromStream(M);
  M.Free;
  Writeln(LW.First, LW.Last, LW.Expand.Count, LW.RandomChanceItem(1), LW.Compare(LW));
  LW.Free;
  LT := TBitList.Create;
  LT.ItemString := '1,2,3';
  LT.Insert(0, True);
  LT.Move(0, 1);
  LT.Exchange(0, 1);
  LT.Pack;
  LT.Remove(True);
  LT[5] := True;
  M := TMemoryStream.Create;
  LT.SaveToStream(M);
  M.Position := 0;
  LT.LoadFromStream(M);
  M.Free;
  Writeln(LT.ItemString, LT.First, LT.Last, LT.Expand.Count, LT.BitsSet, LT.BitsCleared, LT.Compare(LT));
  LT.Free;
  LE := TEventList.Create;
  LE.Add(nil);
  LE.Insert(0, nil);
  LE.Move(0, 1);
  LE.Exchange(0, 1);
  LE.Pack;
  LE.Remove(nil);
  LE[5] := nil;
  LE.TriggerNotifyEvents(nil);
  EV := LE.First(); EV := LE.Last(); EV := LE[0]; Writeln(LE.Expand.Count, LE.Compare(LE));
  LE.Free;
  LD := TDoubleItemList.Create;
  DI.A := 1; DI.B := 2;
  LD.Add(DI);
  LD.AddAB(3, 4);
  LD.Insert(0, DI);
  LD.Move(0, 1);
  LD.Exchange(0, 1);
  LD.Pack;
  LD.Remove(DI);
  LD[5] := DI;
  LD.SortAscendingItemA; LD.SortAscendingItemB; LD.SortDescendingItemA; LD.SortDescendingItemB;
  M := TMemoryStream.Create;
  LD.SaveToStream(M);
  M.Position := 0;
  LD.LoadFromStream(M);
  M.Free;
  DI := LD.First; Writeln(DI.A); DI := LD.Last; Writeln(DI.B);
  Writeln(LD.Expand.Count, LD.IndexOfItemA(1), LD.IndexOfItemB(2), LD.RandomChanceItemA(1), LD.RandomChanceItemB(1), LD.Compare(LD));
  LD.Free;
  LQ := TQuadItemList.Create;
  QI.A := 1; QI.B := 2; QI.C := 3; QI.D := 4;
  LQ.Add(QI);
  LQ.AddABCD(3, 4, 5, 6);
  LQ.Insert(0, QI);
  LQ.Move(0, 1);
  LQ.Exchange(0, 1);
  LQ.Pack;
  LQ.Remove(QI);
  LQ[5] := QI;
  LQ.SortAscendingItemA; LQ.SortAscendingItemB; LQ.SortAscendingItemC; LQ.SortAscendingItemD;
  LQ.SortDescendingItemA; LQ.SortDescendingItemB; LQ.SortDescendingItemC; LQ.SortDescendingItemD;
  M := TMemoryStream.Create;
  LQ.SaveToStream(M);
  M.Position := 0;
  LQ.LoadFromStream(M);
  M.Free;
  QI := LQ.First; Writeln(QI.A); QI := LQ.Last; Writeln(QI.D);
  Writeln(LQ.Expand.Count, LQ.IndexOfItemA(1), LQ.IndexOfItemB(2), LQ.IndexOfItemC(3), LQ.IndexOfItemD(4), LQ.Compare(LQ));
  LQ.Free;
  EN := TEngine.Create(nil);
  N := TENode.Create(EN);
  O := TEObject.Create(N);
  O.SetArrayOwner(N, 0);
  O.MsgProc(Msg, nil);
  O.TimerEvent(0, nil);
  O.Clear;
  O.LastMsg := O.LastMsg;
  Writeln(O.ClassVersion, O.ClassID, O.EObjectPath, O.Compare(O, EN), Byte(O.GetControlStyle));
  O.Assign(O, EN);
  O.Copy(EN).Free;
  O.Editor;
  O.MainReadWrite(nil);
  O.ReadWrite(nil);
  Writeln(O.GetEngine = EN);
  try O.AddRef; except end;
  try O.Release; except end;
  EL := TEObjectEditorList.Create;
  Writeln(EL.FindEditor(1) = nil);
  EL.Free;
  O.Free;
  N.DestroyEObjects(1);
  N.QuickClear;
  N.SendMsg(Msg, nil);
  Writeln(N.SendToChild(Msg), N.FindChildIndex(O), N.FindChild(1) = nil, N.FindOwnedChild(1) = nil, N.FindChildInTree(1) = nil, N.DestroyChildren(1));
  N.Assign(N, EN);
  N.Free;
  with TEWriteStorageStream.Create(M, EN, False) do begin ShowProgress(nil, '', 0); HandleException(nil); Free; end;
  M.Position := 0;
  with TEReadStorageStream.Create(M, EN, False) do begin HandleException(nil); Free; end;
  StringToStream('', M); StringFromStream(S, M); StringsToStream(nil, M); StringsFromStream(nil, M);
  HT := TIntegerHashTable256.Create;
  HT.Add(HT, 1);
  HT.Add(HT, 257);
  Writeln(HT.Find(1) = HT, HT.GetFreeID);
  HT.Delete(257);
  HT.DeleteSafe(HT, 1);
  HT.Clear;
  HT.Free;
  HL := TIntegerHashList.Create;
  HL.Add(HL, 5);
  Writeln(HL.Find(5) = HL);
  HL.Delete(5);
  HL.Free;
  CN := TEControlStyleNode.Create(nil);
  CN.SetControlStyle([csShared]);
  CN.ReadWrite(nil);
  CN.Free;
  CO := TEControlStyleObject.Create(nil);
  CO.SetControlStyle([csShared]);
  CO.ReadWrite(nil);
  CO.Free;
  CW := TECustomOwner.Create(nil);
  CW.SetControlStyle([csShared]);
  CW.SetEngine(EN);
  CW.ReadWrite(nil);
  CW.MsgProc(Msg, nil);
  Writeln(CW.GetEngine = EN);
  CW.Free;
  CL := TEObjectClassList.Create;
  CL.RegisterClass(TEControlStyleNode);
  Writeln(CL.FindClass(1) = nil, CL.FindClassIndex(1), CL.GetClass(1) = nil, CL.EClasses[0] = nil);
  CL.UnregisterClass(TEControlStyleNode);
  CL.Free;
  RS := TEResourceEditSettings.Create(nil);
  Writeln(RS.GetUniqueEditorName('a'), RS.GetEditID('a'));
  RS.RemoveEditor('a');
  RS.ReadWrite(nil);
  RS.Free;
  EN.StartupDirectory := EN.StartupDirectory;
  EN.UpdateStartupDirectory;
  Writeln(EN.TranslateText('x'), EN.RegisterDebugID('d'), EN.IncMsgCount);
  EN.UnregisterDebugID(1);
  EN.OutputDebugStr('s');
  EN.OutputDebugMessage(1, 's');
  EN.ResetMsgCount;
  EN.RegisterEClasses([TEControlStyleNode]);
  EN.UnregisterEClasses([TEControlStyleNode]);
  Writeln(EN.GetEClass(1) = nil, EN.GetDescendantClasses(TEObject).Count, EN.CreateEObject(1, nil) = nil);
  EN.ActivateEObject(O);
  EN.WriteEObject(M, O, nil);
  EN.ReadEObject(M, O, nil);
  EN.WritePreviewEObject(M, O, nil);
  EN.ReadPreviewEObject(M, O, nil);
  EN.StoreEObject(M, O, nil);
  Writeln(EN.RetrieveEObject(M, nil) = nil, EN.RetrieveFromFile('f', nil) = nil);
  EN.StoreInFile('f', O, nil);
  EN.WriteToFile('f', O, nil);
  EN.ReadFromFile('f', O, nil);
  EN.WriteToFileCRC('f', O, nil);
  Writeln(EN.ReadFromFileCRC('f', O, nil));
  EN.ReadTextFromFile('f', O);
  EN.WriteTextToFile('f', O);
  Writeln(EN.VerifyEObjectClass(TEObject));
  InitMsg(Msg, 1, nil);
  InitMsgEx(Msg, 1, nil, 2);
  Writeln(GetCRC32(nil, 0), GetFileCRC32('f'), GetEngine(0) = EN, FindEngine(1) = EN);
  ReleaseCRC32Table;
  FM := TFastMemoryStream.Create;
  FM.Write(S, 4);
  FM.Position := 0;
  FM.Read(S, 4);
  FM.Seek(0, 0);
  FM.Capacity := 64;
  FM.SaveToFile('f');
  FM.LoadFromFile('f');
  FM.Clear;
  FM.Free;
  OL := TEObjectList.Create;
  OL.EObjects[0] := OL.EObjects[0];
  Writeln(OL.FindObject(1) = nil, OL.FindObjectIndex(1), OL.AllHaveCID(1));
  OL.ClearList;
  OL.Free;
  TS := TEWriteTextStorageStream.Create(M, EN);
  TS.rwEObject(O, 1);
  TS.Free;
  TS := TEReadTextStorageStream.Create(M, EN, 0);
  TS.rwEObject(O, 1);
  TS.Free;
  TT := TTranslateStorageStream.Create(EN);
  TT.rwEObject(O, 1);
  TT.TranslateString(S);
  TT.Free;
  TS := TCompareStorageStream.Create(M, EN);
  TS.rwEObject(O, 1);
  TS.Free;
  TS := TSetupCompareStorageStream.Create(M, EN, False);
  TS.Free;
  TN := TETimerNode.Create(nil);
  TN.AddTimerChild(O, 2);
  TN.RemoveTimerChild(O, 2);
  TN.TriggerTimerEvent;
  Writeln(TN.GetTimerList(1).Count, TN.Tick);
  TN.Free;
  CH := TEChangeNotifyNode.Create(nil);
  CH.LockChanged;
  CH.UnlockChanged;
  CH.BeginUpdate;
  CH.Sort(nil);
  CH.EndUpdate;
  CH.Free;
  CH := TEChangeNotifyEventList.Create(nil);
  CH.Free;
  SN := TESortNode.Create(nil);
  SN.AddSortChild(O, 1);
  SN.Sort;
  SN.SortValue[0] := SN.SortValue[0];
  SN.Grow;
  SN.Free;
  SN := TEInverseSortNode.Create(nil);
  SN.Free;
  SN := TEControlStyleSortNode.Create(nil);
  TEControlStyleSortNode(SN).SetControlStyle([]);
  SN.Free;
  SN := TEControlStyleInverseSortNode.Create(nil);
  TEControlStyleInverseSortNode(SN).SetControlStyle([]);
  SN.Free;
  RN := TEReferenceNode.Create(nil);
  RN.Free;
  US := TEUser.Create(nil);
  US.Connect(nil);
  US.Free;
  RL := TEResourceList.Create(nil);
  RL.ValidateResourceID(0);
  Writeln(RL.FindResource(1) = nil, RL.Resources[0] = nil);
  RL.ResourceChanged;
  RL.Free;
  RE := TEResource.Create(nil);
  RE.Draw(nil, RC, bmNone, 0, 0, 0, 0);
  Writeln(RE.ResourceEditName, RE.CreateResourceUser = nil);
  RE.Free;
  CB := TCallBackEventList.Create;
  CB.Add(CBE);
  Writeln(CB.Count, CB[0] = nil);
  CB.Delete(0);
  CB.Free;
  SH := TStringHashTable256.Create;
  SH.Add(SH, 'ab');
  Writeln(SH.Find('ab') = SH);
  SH.Delete('ab');
  SH.Clear;
  SH.Free;
  SL := TStringHashList.Create;
  SL.Free;
  EC := TEComponent.Create(nil);
  EC.Free;
  CS := TCompressStream.Create;
  CS.LoadFromFile('f');
  CS.SaveToFile('f');
  Writeln(CS.SaveToFileEx('f', 3), CS.SaveToStreamEx(M, 3));
  CS.SaveToStream(M);
  CS.LoadFromStream(M);
  CS.Free;
  PI := TPlugIn.Create;
  Writeln(PI.Name, PI.Initialize(EN), PI.Finalize(EN), PI.RefCount, GetPlugIn(0) = PI, FindPlugIn('a') = PI);
  InitializePlugIns(EN);
  FinalizePlugIns(EN);
  PI.AddRef;
  PI.Release;
  PI.Free;
  PC := TPlugInControl.Create(nil);
  PC.UsedPlugIns := PC.UsedPlugIns;
  PC.ReadWrite(nil);
  PC.Free;
  DW := TDebugWriteStream.Create(M, EN);
  DW.rwEObject(O, 1);
  DW.rwEObjectStream(O, 1);
  DW.Free;
  SLS := TStringList.Create;
  SortStrings(SLS, nil);
  SortStringsAscending(SLS, [SLS]);
  SortStringsDescending(SLS, [SLS]);
  SortStringsNumericalAscending(SLS, [SLS]);
  SortStringsNumericalDescending(SLS, [SLS]);
  SLS.Free;
  Writeln(ReplaceText('a', 'b', 'c'), HexToInt('ff'), CopyStreamToClipboard(M, 'x'), PasteStreamFromClipboard(M, 'x'));
  LoadExternalPlugIns('.');
  UnloadExternalPlugIns;
  CC := TECopyComponent.Create(nil);
  CC.EObjects[0] := O;
  Writeln(CC.Count, CC.EObjects[0] = nil);
  CC.CopyToClipboard(EN, 'x');
  CC.PasteFromClipboard(EN, 'x');
  CC.Free;
  EN.Free;
end.
