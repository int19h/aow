{$R '..\..\res\Ilpack.res'}

requires
  vcl30,
  GFXEPACK;

contains
  ImageLib,
  ImgSetEd,
  SImgSEd,
  SubImgEd,
  ILEdForm,
  PerfDlg,
  ILEdGrid,
  ILSpin,
  HashTabU;

end.
